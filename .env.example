# Copy this file to .env and fill in your Fantrax credentials.
# .env is excluded from git — never commit your real credentials.
FANTRAX_EMAIL=your_email@example.com
FANTRAX_PASSWORD=your_fantrax_password

# Fantrax official API (fantrax_api.py). Identify your program; Fantrax rejects requests without one.
FANTRAX_USER_AGENT=HoD-DecisionEngine/1.0
